# ===========================================================================
# HerWay — environment configuration
#
# Copy the backend section to backend/.env and the frontend section to
# frontend/.env.local.
#
# The app starts with none of the optional integrations configured. Each
# feature that needs a missing key reports an outage to the user rather than
# inventing a result. Check GET /health to see what is live.
# ===========================================================================


# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)
# ---------------------------------------------------------------------------

# --- Required for the AI agents -------------------------------------------
# Without this: situation analysis, research planning, safety plans and chat
# all return 503 with an honest message. Everything else still works.
GEMINI_API_KEY=

# Optional. Defaults to `gemini-flash-latest`, a moving alias that survives
# model retirements. Pin a specific version only if you need reproducibility.
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SECONDS=90

# Embedding model for LawBot legal retrieval and community culprit matching.
# `models/text-embedding-004` was retired and returns 404; the default below is
# its replacement. Output is reduced to 768 dimensions to match the existing
# Atlas index. Change the model and the dimensions together, and re-index.
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768

# --- Required for live research -------------------------------------------
# Without this: searches report "not configured" instead of returning empty
# results, so the UI can tell an outage apart from "nothing found".
SERPAPI_API_KEY=
# SERPAPI_KEY=                 # legacy alias, also accepted
# SERPAPI_TIMEOUT_SECONDS=30

# --- Required for persistence ---------------------------------------------
# Without this in development: an in-memory store is used and ALL DATA IS LOST
# on restart (logged loudly, and reported at /health as database=in-memory).
# In production the app refuses to start rather than silently losing cases.
MONGODB_URI=mongodb://localhost:27017
# MONGO_ENDPOINT=              # legacy alias, takes precedence over MONGODB_URI
# MONGO_TIMEOUT_MS=4000
# MONGO_SOCKET_TIMEOUT_MS=8000

# Atlas vector search. LawBot's legal retrieval needs an index over the
# `doc_embedding` collection; community culprit matching needs `culpritIndex2`
# over `culprit_embedding`. Neither is created by the app — see
# docs/KNOWN_ISSUES.md before relying on either.
# LEGAL_VECTOR_INDEX=docEmbeddingIndex
# LEGAL_VECTOR_PATH=embedding

# --- Authentication --------------------------------------------------------
# Clerk, for signed-in accounts. Without it, every visitor gets an isolated
# anonymous session instead — usable, but cases do not follow them across
# devices.
CLERK_ISSUER=
# CLERK_JWKS_URL=          # derived from CLERK_ISSUER when unset
# CLERK_AUDIENCE=

# REQUIRED IN PRODUCTION. Signs the anonymous session cookie. Without it, a
# random per-process secret is used and anonymous sessions do not survive a
# restart. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HERWAY_SESSION_SECRET=

# Set to `production` to enforce the safe configuration: a real database, a
# session secret, Clerk configured, and no dev auth bypass.
# HERWAY_ENV=production

# Local development only. Lets you act as a given user via the X-Dev-User-Id
# header. Refused when HERWAY_ENV=production.
# HERWAY_AUTH_MODE=dev

# Comma-separated browser origins allowed to call the API with credentials.
# HERWAY_ALLOWED_ORIGINS=http://localhost:3000

# Seed illustrative community posts into the in-memory store. Set to false for
# a clean instance.
# HERWAY_SEED_SAMPLE_DATA=true

# --- Optional integrations -------------------------------------------------
# Reverse geocoding for coordinates -> "City, State". Without it, a user must
# type their location; we never guess one.
OPENCAGE_API_KEY=

# Second opinion for formal report drafting. Without it, the Gemini draft is
# used alone.
GROQ_API_TOKEN=

# Image generation for community posts (Amazon Bedrock + S3). Without these,
# that step reports that it is unavailable.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Legacy Twitter share for `POST /send-message`. Not reachable from the current
# UI, and the endpoint has no authentication — leave unset unless you have
# reviewed that. See docs/KNOWN_ISSUES.md.
# TWITTER_CONSUMER_KEY=
# TWITTER_CONSUMER_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_TOKEN_SECRET=
# TWITTER_BEARER_TOKEN=


# ---------------------------------------------------------------------------
# FRONTEND  (frontend/.env.local)
# ---------------------------------------------------------------------------

# Where the FastAPI backend lives. The browser never calls it directly; all
# requests go through the Next.js proxy at /api/v2/*.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# BACKEND_URL=http://localhost:8000      # server-side override
# BACKEND_TIMEOUT_MS=60000

# Clerk. If these are absent the app builds with local auth stand-ins:
# visitors are signed out by default and treated as anonymous sessions.
# A production build refuses to use the stand-ins unless you opt in below.
#
# Copy both from https://dashboard.clerk.com -> your project -> API keys. Do not
# invent them: a made-up but well-formed key makes Clerk reject every request
# with {"errors":[{"message":"Invalid host","code":"host_invalid"}]}, which
# breaks the whole site rather than just sign-in. The app now detects
# placeholder keys and falls back to anonymous sessions instead, printing the
# reason at startup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Escape hatch for that detection. A pk_test_ key must decode to a host of the
# form <word>-<word>-<number>.clerk.accounts.dev, which is how Clerk names
# development instances. Set this to true only if you have a genuine key that
# the check rejects.
# HERWAY_TRUST_CLERK_KEYS=true

# Deliberately deploy without accounts (anonymous-only).
# HERWAY_ALLOW_AUTH_FALLBACK=true

# Clerk user IDs allowed into the responder dashboard at /dashboard, which
# lists incoming community reports. Empty means nobody has access.
HERWAY_ADMIN_USER_IDS=

# Google Maps Embed key, used only on the community post detail map. Without
# it the map is replaced by a plain note rather than a Google error page.
NEXT_PUBLIC_MAP_KEY=

# NOT RECOMMENDED. `frontend/src/lib/utils.ts` can call OpenCage straight from
# the browser, which publishes the key to anyone who views source and sends the
# user's coordinates to a third party without passing through the server. That
# helper is currently unused; prefer the server-side OPENCAGE_API_KEY above.
# NEXT_PUBLIC_OPENCAGE_API_KEY=
